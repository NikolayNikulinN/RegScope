<ui:FluentWindow x:Class="RegScope.Views.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:res="clr-namespace:RegScope.Resources;assembly=RegScope.Application"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:RegScope.ViewModels"
                 xmlns:views="clr-namespace:RegScope.Views"
                 Title="{x:Static res:Strings.AppTitle}"
                 Width="1180"
                 Height="720"
                 MinWidth="960"
                 MinHeight="560"
                 Background="{DynamicResource AppBackgroundBrush}"
                 Foreground="{DynamicResource TextBrush}"
                 Icon="pack://application:,,,/Images/appIcon.ico"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <views:BindingProxy x:Key="ViewModelProxy" Data="{Binding}" />
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF2F5" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EEF6F8" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#CBD5DE" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F7D8C" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#286B78" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F5863" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#D9EEF2" />
        <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
        <SolidColorBrush x:Key="GroupRowBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#B42318" />
        <SolidColorBrush x:Key="ResultColumnSeparatorBrush" Color="#D4DCE3" />

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style x:Key="ResultCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ResultChildCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ResultChildCellBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource ResultColumnSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>

        <Style x:Key="ResultChildLastCellBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:RegistrySearchResultGroupViewModel}"
                                  ItemsSource="{Binding Items}">
            <Border MinHeight="38"
                    Margin="0,1,0,0"
                    Padding="0,3"
                    Background="{StaticResource GroupRowBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Margin="4,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="18"
                              MinHeight="18"
                              IsEnabled="{Binding Data.IsIdle, Source={StaticResource ViewModelProxy}}"
                              IsThreeState="True"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1"
                               FontWeight="SemiBold"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding Hive}" />
                    <TextBlock Grid.Column="2"
                               FontWeight="SemiBold"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding FullPath}"
                               ToolTip="{Binding FullPath}" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding MatchType}" />
                    <TextBlock Grid.Column="7"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding CanDeleteKey}" />
                    <TextBlock Grid.Column="8"
                               Foreground="#A4262C"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding ErrorMessage}" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:RegistrySearchResultItemViewModel}">
            <Grid MinHeight="36"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <CheckBox HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="18"
                              MinHeight="18"
                              IsEnabled="{Binding Data.IsIdle, Source={StaticResource ViewModelProxy}}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding Hive}" />
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding DisplayPath}"
                               ToolTip="{Binding FullPath}" />
                </Border>
                <Border Grid.Column="3"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding MatchType}" />
                </Border>
                <Border Grid.Column="4"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueName}" />
                </Border>
                <Border Grid.Column="5"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueKind}" />
                </Border>
                <Border Grid.Column="6"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueData}" />
                </Border>
                <Border Grid.Column="7"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding CanDeleteKey}" />
                </Border>
                <Border Grid.Column="8"
                        Style="{StaticResource ResultChildLastCellBorderStyle}">
                    <TextBlock Foreground="{StaticResource ErrorTextBrush}"
                               Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ErrorMessage}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static res:Strings.AppTitle}"
                     Icon="{ui:ImageIcon 'pack://application:,,,/Images/appIcon.ico'}" />

        <Border Grid.Row="1"
                Margin="12,8,12,10"
                Padding="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         IsEnabled="{Binding IsIdle}"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1"
                          Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsIdle}"
                          ItemsSource="{Binding HiveOptions}"
                          SelectedItem="{Binding SelectedHiveOption}" />

                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Command="{Binding SearchCommand}"
                        Content="{x:Static res:Strings.SearchButton}" />

                <Button Grid.Column="3"
                        Margin="0,0,8,0"
                        Command="{Binding StopCommand}"
                        Content="{x:Static res:Strings.StopButton}" />

                <Button Grid.Column="4"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Content="{x:Static res:Strings.DeleteSelectedButton}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="12,0,12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TreeView BorderThickness="0"
                          ItemsSource="{Binding ResultGroups}"
                          Padding="0,3,0,0"
                          HorizontalContentAlignment="Left"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2933" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2933" />
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Width="120"
                             Height="4"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding SearchStatus}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ResultCountText}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
