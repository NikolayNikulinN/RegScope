<Application x:Class="RegScope.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewModels="clr-namespace:RegScope.ViewModels"
             xmlns:views="clr-namespace:RegScope.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/RegScope.Presentation;component/Styles/Colors.xaml" />
                <ResourceDictionary Source="/RegScope.Presentation;component/Styles/TextBoxes.xaml" />
                <ResourceDictionary Source="/RegScope.Presentation;component/Styles/Buttons.xaml" />
                <ResourceDictionary Source="/RegScope.Presentation;component/Styles/Lists.xaml" />
                <ResourceDictionary Source="/RegScope.Presentation;component/Styles/RegistrySearch.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
                <views:HomePage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
