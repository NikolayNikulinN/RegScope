<UserControl x:Class="RegScope.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RegScope.ViewModels"
             xmlns:models="clr-namespace:RegScope.Model"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:RegistrySearchResultGroupModel}"
                                  ItemsSource="{Binding Items}">
            <Border MinHeight="38"
                    Margin="0,1,0,0"
                    Padding="0,3"
                    Background="{StaticResource GroupRowBrush}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              Margin="4,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="18"
                              MinHeight="18"
                              IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              IsThreeState="True"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="1"
                               FontWeight="SemiBold"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding Hive}" />
                    <TextBlock Grid.Column="2"
                               FontWeight="SemiBold"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding FullPath}"
                               ToolTip="{Binding FullPath}" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding MatchType}" />
                    <TextBlock Grid.Column="7"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding CanDeleteKey}" />
                    <TextBlock Grid.Column="8"
                               Foreground="{StaticResource SoftDeleteButtonForegroundBrush}"
                               Style="{StaticResource ResultCellTextBlockStyle}"
                               Text="{Binding ErrorMessage}" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:RegistrySearchResultItemModel}">
            <Grid MinHeight="36"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="30" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <CheckBox HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MinWidth="18"
                              MinHeight="18"
                              IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Border>
                <Border Grid.Column="1"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding Hive}" />
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding DisplayPath}"
                               ToolTip="{Binding FullPath}" />
                </Border>
                <Border Grid.Column="3"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding MatchType}" />
                </Border>
                <Border Grid.Column="4"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueName}" />
                </Border>
                <Border Grid.Column="5"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueKind}" />
                </Border>
                <Border Grid.Column="6"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ValueData}" />
                </Border>
                <Border Grid.Column="7"
                        Style="{StaticResource ResultChildCellBorderStyle}">
                    <TextBlock Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding CanDeleteKey}" />
                </Border>
                <Border Grid.Column="8"
                        Style="{StaticResource ResultChildLastCellBorderStyle}">
                    <TextBlock Foreground="{StaticResource ErrorTextBrush}"
                               Style="{StaticResource ResultChildCellTextBlockStyle}"
                               Text="{Binding ErrorMessage}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,8,12,10"
                Padding="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Margin="0,0,8,0"
                         IsEnabled="{Binding IsIdle}"
                         VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1"
                          Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsIdle}"
                          ItemsSource="{Binding HiveOptions}"
                          SelectedItem="{Binding SelectedHiveOption}" />

                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Command="{Binding SearchCommand}"
                        Content="{Binding SearchButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="3"
                        Margin="0,0,8,0"
                        Command="{Binding StopCommand}"
                        Content="{Binding StopButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="4"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Content="{Binding DeleteSelectedButton, Source={StaticResource ResourceWrapper}}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TreeView BorderThickness="0"
                          ItemsSource="{Binding ResultGroups}"
                          Padding="0,3,0,0"
                          HorizontalContentAlignment="Left"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <StaticResource ResourceKey="RegistryTreeViewItemStyle" />
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Width="120"
                             Height="4"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding SearchStatus}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ResultCountText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
