<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>RegScope</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPlatform Condition="'$(Platform)' == 'x86'">x86</OutputPlatform>
    <OutputPlatform Condition="'$(OutputPlatform)' == ''">x64</OutputPlatform>
    <OutputPath>bin\$(Configuration)\$(OutputPlatform)\</OutputPath>
    <OutDir>$(MSBuildProjectDirectory)\$(OutputPath)</OutDir>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <SuppressValidation>true</SuppressValidation>
    <InstallerProductVersion Condition="'$(InstallerProductVersion)' == ''">1.0.0</InstallerProductVersion>
    <RegScopePayloadDir>$(MSBuildProjectDirectory)\obj\RegScopePayload\$(Configuration)\$(OutputPlatform)\</RegScopePayloadDir>
    <RegScopePayloadIntermediateDir>obj\RegScopePayloadIntermediate\$(Configuration)\$(OutputPlatform)\</RegScopePayloadIntermediateDir>
    <DefineConstants>InstallerProductVersion=$(InstallerProductVersion);RegScopePayloadDir=$(RegScopePayloadDir);$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <Target Name="BuildRegScopePayload" BeforeTargets="CoreCompile">
    <MSBuild
        Projects="..\RegScope\RegScope.csproj"
        Targets="Build"
        Properties="Configuration=$(Configuration);Platform=$(Platform);OutDir=$(RegScopePayloadDir);IntermediateOutputPath=$(RegScopePayloadIntermediateDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
