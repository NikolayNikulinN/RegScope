<UserControl x:Class="RegScope.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RegScope.ViewModels"
             xmlns:models="clr-namespace:RegScope.Model"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:RegistrySearchResultGroupModel}"
                                  ItemsSource="{Binding Items}">
            <Border MinHeight="44"
                    Margin="0,1,0,0"
                    Padding="0,4"
                    Background="{StaticResource GroupRowBrush}"
                    CornerRadius="5"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                              IsThreeState="True"
                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Margin="8,0,12,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="22"
                               Height="22"
                               Margin="0,0,10,0"
                               Source="pack://application:,,,/RegScope.Presentation;component/Images/folder.png"
                               Stretch="Uniform" />
                        <TextBlock FontWeight="SemiBold"
                                   Style="{StaticResource RegistryResultNameTextStyle}"
                                   Text="{Binding DisplayFullPath}" />
                    </StackPanel>
                    <Border Grid.Column="4"
                            Margin="10,0,12,0"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="10"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="Registry Key"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Grid.Column="3"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ErrorTextBrush}"
                               Text="{Binding ErrorMessage}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:RegistrySearchResultItemModel}">
            <Grid MinHeight="42"
                  Margin="0,0,0,1"
                  Background="{StaticResource SurfaceBrush}"
                  SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="1"
                            Margin="8,0,12,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image x:Name="ResultIcon"
                           Width="25"
                           Height="22"
                           Margin="0,0,12,0"
                           Source="pack://application:,,,/RegScope.Presentation;component/Images/file.png"
                           Stretch="Uniform" />
                    <TextBlock x:Name="ResultName"
                               FontWeight="SemiBold"
                               Style="{StaticResource RegistryResultNameTextStyle}"
                               Text="{Binding DisplayPath}" />
                </StackPanel>
                <Border x:Name="ResultTypeBadge"
                        Grid.Column="2"
                        Style="{StaticResource RegistryResultTypeBadgeStyle}">
                    <TextBlock x:Name="ResultType"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12"
                               Text="{Binding ValueKind}" />
                </Border>
                <TextBlock Grid.Column="3"
                           Margin="10,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding ValueData}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ValueData}" />
                <TextBlock Grid.Column="1"
                           Grid.ColumnSpan="3"
                           Margin="42,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource ErrorTextBrush}"
                           Text="{Binding ErrorMessage}"
                           TextTrimming="CharacterEllipsis"
                           Panel.ZIndex="1" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Result.IsValueResult}" Value="False">
                    <Setter TargetName="ResultIcon" Property="Source" Value="pack://application:,,,/RegScope.Presentation;component/Images/folder.png" />
                    <Setter TargetName="ResultType" Property="Text" Value="Registry Key" />
                    <Setter TargetName="ResultName" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="ResultTypeBadge" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="ResultType" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="ResultType" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueKind}" Value="ExpandString">
                    <Setter TargetName="ResultTypeBadge" Property="Background" Value="{StaticResource ExpandStringBadgeBrush}" />
                    <Setter TargetName="ResultType" Property="Foreground" Value="{StaticResource ExpandStringBadgeTextBrush}" />
                    <Setter TargetName="ResultType" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="12,8,12,10"
                Padding="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <TextBox x:Name="SearchTextBox"
                             IsEnabled="{Binding IsIdle}"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="{Binding SearchWatermark, Source={StaticResource ResourceWrapper}}"
                               Style="{StaticResource SearchWatermarkTextBlockStyle}" />
                </Grid>

                <ComboBox Grid.Column="1"
                          Margin="0,0,8,0"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsIdle}"
                          ItemsSource="{Binding HiveOptions}"
                          SelectedItem="{Binding SelectedHiveOption}" />

                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Command="{Binding SearchCommand}"
                        Content="{Binding SearchButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="3"
                        Margin="0,0,8,0"
                        Command="{Binding StopCommand}"
                        Content="{Binding StopButton, Source={StaticResource ResourceWrapper}}" />

                <Button Grid.Column="4"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding IsIdle}"
                        Content="{Binding DeleteSelectedButton, Source={StaticResource ResourceWrapper}}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12,0,12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TreeView BorderThickness="0"
                          ItemsSource="{Binding ResultGroups}"
                          Padding="0,3,0,0"
                          HorizontalContentAlignment="Left"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <StaticResource ResourceKey="RegistryTreeViewItemStyle" />
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="No Data">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyResultsTextBlockStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultGroups.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Width="120"
                             Height="4"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center"
                             IsIndeterminate="True"
                             Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding SearchStatus}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding ResultCountText}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
